{
  "name": "@deterministic-code/generators-openapi",
  "version": "0.0.1",
  "description": "OpenAPI generator pack for the deterministic toolchain: openapi.json emit and language wrappers.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./generate-openapi-docs": {
      "types": "./dist/generate-openapi-docs.d.ts",
      "import": "./dist/generate-openapi-docs.js"
    },
    "./generate-openapi": {
      "types": "./dist/generate-openapi.d.ts",
      "import": "./dist/generate-openapi.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*/*": {
      "types": "./dist/*/*.d.ts",
      "import": "./dist/*/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/templates dist/",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --experimental-strip-types --test src/generate-openapi.integration.test.ts src/generate-openapi.samples.test.ts"
  },
  "dependencies": {
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
