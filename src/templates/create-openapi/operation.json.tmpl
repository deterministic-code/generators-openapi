{
  "summary": {{summaryJson}},
  "operationId": {{operationIdJson}}{{#hasOperationTags}},
  "tags": [
{{#operationTags}}
    {{nameJson}}{{^last}},{{/last}}
{{/operationTags}}
  ]{{/hasOperationTags}}{{#hasParameters}},
  "parameters": [
{{#parameters}}
    {
      "name": {{nameJson}},
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      }
    }{{^last}},{{/last}}
{{/parameters}}{{#hasIfMatch}}{{#hasPathParameters}},{{/hasPathParameters}}
    {
      "name": "If-Match",
      "in": "header",
      "required": true,
      "description": "The resource `updated` timestamp from the last GET.",
      "schema": {
        "type": "string",
        "format": "date-time"
      }
    }{{/hasIfMatch}}
  ]{{/hasParameters}}{{#hasRequestBody}},
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {{&requestSchemaJson}}
      }
    }
  }{{/hasRequestBody}},
  "responses": {
    "200": {
      "description": "OK"{{#hasResponseBody}},
      "content": {
        "application/json": {
          "schema": {{&responseSchemaJson}}
        }
      }{{/hasResponseBody}}
    }{{#hasIfMatch}},
    "412": {
      "description": "Precondition Failed — If-Match does not match the current `updated` timestamp"
    },
    "428": {
      "description": "Precondition Required — If-Match header is required"
    }{{/hasIfMatch}}
  }
}
